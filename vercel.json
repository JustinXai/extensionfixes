{
  "redirects": [
    {
      "source": "/fix/chrome-extension-disabled",
      "destination": "/fix/chrome-disabled-extension",
      "permanent": true
    },
    {
      "source": "/fix/chrome-extension-disabled/",
      "destination": "/fix/chrome-disabled-extension",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.extensionfixes.com"
        }
      ],
      "destination": "https://extensionfixes.com/:path*",
      "permanent": true
    }
  ]
}
